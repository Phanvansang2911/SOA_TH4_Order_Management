          "raw": "{\n  \"customerName\": \"Nguyen Van A\",\n  \"customerEmail\": \"a@example.com\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}",
